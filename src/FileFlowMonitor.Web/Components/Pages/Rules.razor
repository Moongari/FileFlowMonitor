@page "/rules"
@inject IHttpClientFactory ClientFactory
<PageTitle>Règles de surveillance | FileFlow Monitor</PageTitle>
<div class="page-heading"><div><div class="eyebrow">CONFIGURATION</div><h1>Règles de surveillance</h1><p>Définissez quels fichiers doivent arriver, où et à quelle heure.</p></div><button class="button-primary" @onclick="ShowCreate">＋ Nouvelle règle</button></div>
@if (!string.IsNullOrEmpty(_message)) { <div class="alert alert-info">@_message</div> }
@if (!string.IsNullOrEmpty(_error)) { <div class="alert alert-error">@_error</div> }
@if (_showForm)
{
<section class="panel form-panel"><div class="panel-heading"><div><h2>Nouvelle règle</h2><p>Configurez les attentes de réception.</p></div><button class="icon-button" @onclick="Cancel">✕</button></div>
<EditForm Model="_form" OnValidSubmit="CreateAsync">
<div class="form-grid">
<label>Nom de la règle<input @bind="_form.Name" placeholder="Ex. Citi - fichiers de trading" required /></label>
<label>Chemin du dossier<input @bind="_form.FolderPath" placeholder="D:\FileFlow\Citi ou \\serveur\partage" required /></label>
<label>Mode de reconnaissance<select @bind="_form.MatchingMode"><option value="0">Noms exacts</option><option value="1">Modèle de nommage</option><option value="2">Motif (pattern)</option><option value="3">Quantité de fichiers</option></select></label>
<label>Nom(s) attendu(s)<input @bind="_form.ExpectedFileNamesText" placeholder="trades.csv, positions.csv" /></label>
<label>Extensions autorisées<input @bind="_form.AllowedExtensionsText" placeholder="csv, xlsx, pdf" /></label>
<label>Horaires locaux<input @bind="_form.ScheduleTimesText" placeholder="08:00, 12:00, 16:00" /></label>
<label>Jours de surveillance<select @bind="_form.Days"><option value="31">Lundi au vendredi</option><option value="127">Tous les jours</option><option value="96">Samedi et dimanche</option></select></label>
<label>Fuseau horaire<input @bind="_form.TimeZoneId" /></label>
<label>Délai de grâce (minutes)<input type="number" min="0" max="1440" @bind="_form.GracePeriodMinutes" /></label>
<label>Stabilité fichier (secondes)<input type="number" min="0" max="3600" @bind="_form.StabilityPeriodSeconds" /></label>
</div>
<div class="form-help">Pour le mode « Noms exacts », indiquez tous les noms attendus séparés par des virgules. Les horaires utilisent le fuseau choisi.</div>
<div class="form-actions"><button type="button" class="button-secondary" @onclick="Cancel">Annuler</button><button type="submit" class="button-primary" disabled="@_saving">@(_saving ? "Enregistrement…" : "Créer la règle")</button></div>
</EditForm></section>
}
<section class="panel">
<div class="panel-heading"><div><h2>Règles configurées</h2><p>@_rules.Count règle(s) • Les règles actives sont prises en compte par le moteur.</p></div><button class="button-secondary button-small" @onclick="LoadAsync">↻ Actualiser</button></div>
@if (_loading) { <div class="loading-panel">Chargement des règles…</div> }
else if (_rules.Count == 0) { <div class="empty-state"><div class="empty-icon">⚙</div><h3>Aucune règle configurée</h3><p>Créez une première règle pour commencer à surveiller un dossier.</p><button class="button-primary" @onclick="ShowCreate">Créer ma première règle</button></div> }
else {
<div class="table-wrap"><table><thead><tr><th>Nom</th><th>Dossier</th><th>Reconnaissance</th><th>Horaires</th><th>Grace</th><th>État</th><th>Actions</th></tr></thead><tbody>
@foreach (var rule in _rules)
{ <tr><td><strong>@rule.Name</strong><small class="sub-cell">@rule.TimeZoneId</small></td><td class="path-cell">@rule.FolderPath</td><td>@MatchingLabel(rule.MatchingMode)</td><td>@string.Join(" · ", rule.ScheduleTimes.Select(x => x[..5]))</td><td>@rule.GracePeriodMinutes min</td><td><span class="pill @(rule.IsEnabled ? "pill-green" : "pill-muted")">@(rule.IsEnabled ? "Active" : "Désactivée")</span></td><td class="actions"><button class="button-link" @onclick="() => ToggleAsync(rule)">@((rule.IsEnabled) ? "Suspendre" : "Activer")</button><button class="button-link danger-link" @onclick="() => DeleteAsync(rule)">Supprimer</button></td></tr> }
</tbody></table></div>
}
</section>
@code {
 private List<RuleView> _rules = [];
 private RuleForm _form = new();
 private bool _loading = true, _showForm, _saving;
 private string? _error, _message;
 protected override async Task OnInitializedAsync() => await LoadAsync();
 private HttpClient Api => ClientFactory.CreateClient("FileFlowApi");
 private async Task LoadAsync() { _loading=true; _error=null; try { _rules=await Api.GetFromJsonAsync<List<RuleView>>("api/monitoring-rules") ?? []; } catch(Exception ex){_error="Impossible de charger les règles : "+ex.Message;} finally{_loading=false;} }
 private void ShowCreate(){_form=new RuleForm();_showForm=true;_message=null;}
 private void Cancel()=>_showForm=false;
 private async Task CreateAsync()
 {
   _saving=true;_error=null;
   try {
     var payload=new { name=_form.Name, folderPath=_form.FolderPath, matchingMode=_form.MatchingMode,
       fileNamePattern=(string?)null, expectedCount=1,
       expectedFileNames=_form.ExpectedFileNamesText.Split(',',StringSplitOptions.RemoveEmptyEntries|StringSplitOptions.TrimEntries),
       allowedExtensions=_form.AllowedExtensionsText.Split(',',StringSplitOptions.RemoveEmptyEntries|StringSplitOptions.TrimEntries),
       scheduleTimes=_form.ScheduleTimesText.Split(',',StringSplitOptions.RemoveEmptyEntries|StringSplitOptions.TrimEntries).Select(x=>TimeOnly.Parse(x).ToString("HH:mm:ss")),
       days=_form.Days,timeZoneId=_form.TimeZoneId,gracePeriodMinutes=_form.GracePeriodMinutes,
       stabilityPeriodSeconds=_form.StabilityPeriodSeconds,isEnabled=true };
     var response=await Api.PostAsJsonAsync("api/monitoring-rules",payload);
     if(!response.IsSuccessStatusCode){_error="La création a échoué : "+await response.Content.ReadAsStringAsync();return;}
     _showForm=false;_message="La règle a été créée. Le moteur la prendra en compte au prochain cycle.";await LoadAsync();
   } catch(Exception ex){_error="Vérifiez les noms de fichiers, les horaires et le fuseau horaire : "+ex.Message;}
   finally{_saving=false;}
 }
 private async Task ToggleAsync(RuleView rule)
 {
   var response=await Api.PatchAsJsonAsync($"api/monitoring-rules/{rule.Id}/enabled",new {isEnabled=!rule.IsEnabled});
   if(response.IsSuccessStatusCode){_message=$"Règle « {rule.Name} » mise à jour.";await LoadAsync();}else{_error="Impossible de modifier cette règle.";}
 }
 private async Task DeleteAsync(RuleView rule)
 {
   var response=await Api.DeleteAsync($"api/monitoring-rules/{rule.Id}");
   if(response.IsSuccessStatusCode){_message=$"Règle « {rule.Name} » supprimée.";await LoadAsync();}else{_error="Impossible de supprimer cette règle.";}
 }
 private static string MatchingLabel(int mode)=>mode switch{0=>"Noms exacts",1=>"Modèle",2=>"Motif",3=>"Quantité",_=>"Inconnu"};
 private sealed class RuleForm { public string Name{get;set;}=""; public string FolderPath{get;set;}=""; public int MatchingMode{get;set;} public string ExpectedFileNamesText{get;set;}=""; public string AllowedExtensionsText{get;set;}="csv"; public string ScheduleTimesText{get;set;}="08:00, 12:00"; public int Days{get;set;}=31; public string TimeZoneId{get;set;}="Europe/Paris"; public int GracePeriodMinutes{get;set;}=15; public int StabilityPeriodSeconds{get;set;}=5; }
 private sealed class RuleView { public Guid Id{get;set;} public string Name{get;set;}=""; public string FolderPath{get;set;}=""; public int MatchingMode{get;set;} public int GracePeriodMinutes{get;set;} public string TimeZoneId{get;set;}=""; public bool IsEnabled{get;set;} public List<string> ScheduleTimes{get;set;}=[]; }
}
