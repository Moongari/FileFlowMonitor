@page "/rules"
@inject IHttpClientFactory ClientFactory
<PageTitle>Règles de surveillance | FileFlow Monitor</PageTitle>
<div class="page-heading"><div><div class="eyebrow">CONFIGURATION</div><h1>Règles de surveillance</h1><p>Définissez quels fichiers doivent arriver, où et à quelle heure.</p></div><button class="button-primary" @onclick="ShowCreate">＋ Nouvelle règle</button></div>
@if (!string.IsNullOrEmpty(_message)) { <div class="alert alert-info">@_message</div> }
@if (!string.IsNullOrEmpty(_error)) { <div class="alert alert-error">@_error</div> }
@if (_showForm)
{
<section class="panel form-panel"><div class="panel-heading"><div><h2>@(_editingId.HasValue ? "Modifier la règle" : "Nouvelle règle")</h2><p>Configurez les attentes de réception.</p></div><button class="icon-button" @onclick="Cancel">✕</button></div>
<EditForm Model="_form" OnValidSubmit="SaveAsync">
<div class="form-grid">
<label>Nom de la règle<input @bind="_form.Name" placeholder="Ex. Citi - fichiers de trading" required /></label>
<label>Chemin du dossier<input @bind="_form.FolderPath" placeholder="D:\FileFlow\Citi ou \\serveur\partage" required /></label>
<label>Mode de reconnaissance<select @bind="_form.MatchingMode"><option value="0">Noms exacts</option><option value="1">Modèle de nommage</option><option value="2">Motif (expression régulière)</option><option value="3">Quantité de fichiers</option></select></label>
@if (_form.MatchingMode == 0)
{
<label>Nom(s) attendu(s)<input @bind="_form.ExpectedFileNamesText" placeholder="trades.csv, positions.csv" /></label>
}
@if (_form.MatchingMode == 1)
{
<label>Modèle de nommage<input @bind="_form.FileNamePattern" placeholder="trade1_{DATE}_{TIME}.csv; trade2_{DATE}_{TIME}.csv" /></label>
}
@if (_form.MatchingMode == 2)
{
<label>Expression régulière<input @bind="_form.FileNamePattern" placeholder="^Trade[12]_\d{8}_\d{5}\.csv$" /></label>
<label>Nombre de fichiers attendus<input type="number" min="1" max="500" @bind="_form.ExpectedCount" /></label>
}
@if (_form.MatchingMode == 3)
{
<label>Nombre de fichiers attendus<input type="number" min="1" max="500" @bind="_form.ExpectedCount" /></label>
}
<label>Extensions autorisées<input @bind="_form.AllowedExtensionsText" placeholder="csv, xlsx, pdf" /></label>
<label class="schedule-manual">Horaires locaux<input @bind="_form.ScheduleTimesText" placeholder="08:00, 12:00, 16:00" /><small class="sub-cell">Vous pouvez conserver une liste manuelle ou utiliser le générateur ci-dessous.</small></label>
<div class="schedule-generator">
<div class="schedule-generator-heading"><strong>Générer automatiquement les horaires</strong><small>Définissez une plage et un intervalle. Les bornes sont incluses.</small></div>
<div class="schedule-generator-fields">
<label>De<input type="time" @bind="_form.ScheduleStartTime" /></label>
<label>À<input type="time" @bind="_form.ScheduleEndTime" /></label>
<label>Intervalle (minutes)<input type="number" min="1" max="1440" @bind="_form.ScheduleIntervalMinutes" /></label>
<button type="button" class="button-secondary button-small" @onclick="GenerateScheduleTimes">Générer les horaires</button>
</div>
@if (!string.IsNullOrWhiteSpace(_scheduleGeneratorMessage))
{
<div class="form-help">@_scheduleGeneratorMessage</div>
}
</div>
<label>Jours de surveillance<select @bind="_form.Days"><option value="31">Lundi au vendredi</option><option value="127">Tous les jours</option><option value="96">Samedi et dimanche</option></select></label>
<label>Fuseau horaire<input @bind="_form.TimeZoneId" /></label>
<label>Délai de grâce (minutes)<input type="number" min="0" max="1440" @bind="_form.GracePeriodMinutes" /></label>
<label>Stabilité fichier (secondes)<input type="number" min="0" max="3600" @bind="_form.StabilityPeriodSeconds" /></label>
</div>
<div class="form-help">
@if (_form.MatchingMode == 0) { <span>Chaque nom exact est attendu à chaque horaire.</span> }
@if (_form.MatchingMode == 1) { <span>Un modèle par fichier, séparés par des points-virgules. Variables : {DATE} (yyyyMMdd), {YYYY}, {MM}, {DD}, {TIME} (HHmmss ou HHmm0), {HH}, {MINUTES}, {SECONDS}. Chaque modèle est décliné à chaque horaire.</span> }
@if (_form.MatchingMode == 2) { <span>L'expression régulière est appliquée au nom du fichier, sans tenir compte de la casse. Le nombre d'occurrences attendues est défini par « Nombre de fichiers attendus ».</span> }
@if (_form.MatchingMode == 3) { <span>Le moteur compte le nombre de fichiers reçus à chaque horaire. Les extensions autorisées servent de filtre ; sans extension, tous les fichiers sont comptés.</span> }
</div>
<div class="form-actions"><button type="button" class="button-secondary" @onclick="Cancel">Annuler</button><button type="submit" class="button-primary" disabled="@_saving">@(_saving ? "Enregistrement…" : (_editingId.HasValue ? "Enregistrer les modifications" : "Créer la règle"))</button></div>
</EditForm></section>
}
<section class="panel">
<div class="panel-heading"><div><h2>Règles configurées</h2><p>@_rules.Count règle(s) • Les règles actives sont prises en compte par le moteur.</p></div><button class="button-secondary button-small" @onclick="LoadAsync">↻ Actualiser</button></div>
@if (_loading) { <div class="loading-panel">Chargement des règles…</div> }
else if (_rules.Count == 0) { <div class="empty-state"><div class="empty-icon">⚙</div><h3>Aucune règle configurée</h3><p>Créez une première règle pour commencer à surveiller un dossier.</p><button class="button-primary" @onclick="ShowCreate">Créer ma première règle</button></div> }
else {
<div class="table-wrap"><table><thead><tr><th>Nom</th><th>Dossier</th><th>Reconnaissance</th><th>Horaires</th><th>Grace</th><th>État</th><th>Actions</th></tr></thead><tbody>
@foreach (var rule in _rules)
{ <tr><td><strong>@rule.Name</strong><small class="sub-cell">@rule.TimeZoneId</small></td><td class="path-cell">@rule.FolderPath</td><td>@MatchingLabel(rule.MatchingMode)</td><td>@string.Join(" · ", rule.ScheduleTimes.Select(x => x[..5]))</td><td>@rule.GracePeriodMinutes min</td><td><span class="pill @(rule.IsEnabled ? "pill-green" : "pill-muted")">@(rule.IsEnabled ? "Active" : "Désactivée")</span></td><td class="actions"><button class="button-link" @onclick="() => ShowEdit(rule)">Modifier</button><button class="button-link" @onclick="() => ToggleAsync(rule)">@((rule.IsEnabled) ? "Suspendre" : "Activer")</button><button class="button-link danger-link" @onclick="() => AskDelete(rule)">Supprimer</button></td></tr> }
</tbody></table></div>
}
</section>
@if (_pendingDelete is not null)
{
<div class="modal-backdrop"><section class="confirm-modal"><div class="eyebrow">CONFIRMATION</div><h2>Supprimer cette règle ?</h2><p>La règle « @_pendingDelete.Name » sera supprimée. Cette action est définitive.</p><div class="form-actions"><button class="button-secondary" @onclick="CancelDelete">Annuler</button><button class="button-primary danger-button" @onclick="ConfirmDeleteAsync">Confirmer la suppression</button></div></section></div>
}
@code {
 private List<RuleView> _rules = [];
 private RuleForm _form = new();
 private bool _loading = true, _showForm, _saving;
 private Guid? _editingId;
 private RuleView? _pendingDelete;
 private string? _error, _message, _scheduleGeneratorMessage;
 protected override async Task OnInitializedAsync() => await LoadAsync();
 private HttpClient Api => ClientFactory.CreateClient("FileFlowApi");
 private async Task LoadAsync() { _loading=true; _error=null; try { _rules=await Api.GetFromJsonAsync<List<RuleView>>("api/monitoring-rules") ?? []; } catch(Exception ex){_error="Impossible de charger les règles : "+ex.Message;} finally{_loading=false;} }
 private void ShowCreate(){_form=new RuleForm();_editingId=null;_showForm=true;_message=null;}
 private void ShowEdit(RuleView rule){
   _editingId=rule.Id;_showForm=true;_message=null;
   _form=new RuleForm { Name=rule.Name, FolderPath=rule.FolderPath, MatchingMode=rule.MatchingMode,
     FileNamePattern=rule.FileNamePattern??"", ExpectedCount=rule.ExpectedCount,
     ExpectedFileNamesText=string.Join(", ",rule.ExpectedFileNames),
     AllowedExtensionsText=string.Join(", ",rule.AllowedExtensions),
     ScheduleTimesText=string.Join(", ",rule.ScheduleTimes.Select(x=>x[..5])),
     Days=rule.Days,TimeZoneId=rule.TimeZoneId,GracePeriodMinutes=rule.GracePeriodMinutes,
     StabilityPeriodSeconds=rule.StabilityPeriodSeconds };
 }
 private void Cancel(){_showForm=false;_editingId=null;_scheduleGeneratorMessage=null;}
 private void GenerateScheduleTimes()
 {
   _scheduleGeneratorMessage=null;
   var start=TimeOnly.FromDateTime(_form.ScheduleStartTime);
   var end=TimeOnly.FromDateTime(_form.ScheduleEndTime);
   if(_form.ScheduleIntervalMinutes<1 || _form.ScheduleIntervalMinutes>1440)
   {
     _scheduleGeneratorMessage="L'intervalle doit être compris entre 1 et 1 440 minutes.";
     return;
   }
   if(end<start)
   {
     _scheduleGeneratorMessage="L'heure de fin doit être postérieure ou égale à l'heure de début. Pour une plage après minuit, créez une règle distincte.";
     return;
   }
   var times=new List<string>();
   for(var minutes=start.Hour*60+start.Minute; minutes<=end.Hour*60+end.Minute; minutes+=_form.ScheduleIntervalMinutes)
   {
     times.Add($"{minutes/60:00}:{minutes%60:00}");
   }
   if(times.Count==0)
   {
     _scheduleGeneratorMessage="Aucun horaire n'a été généré.";
     return;
   }
   _form.ScheduleTimesText=string.Join(", ",times);
   _scheduleGeneratorMessage=$"{times.Count} horaire(s) généré(s), de {times[0]} à {times[^1]}. La liste remplace les horaires précédents.";
 }
 private async Task SaveAsync()
 {
   _saving=true;_error=null;
   try {
     var payload=new { name=_form.Name, folderPath=_form.FolderPath, matchingMode=_form.MatchingMode,
       fileNamePattern=string.IsNullOrWhiteSpace(_form.FileNamePattern)?null:_form.FileNamePattern, expectedCount=_form.ExpectedCount,
       expectedFileNames=_form.ExpectedFileNamesText.Split(',',StringSplitOptions.RemoveEmptyEntries|StringSplitOptions.TrimEntries),
       allowedExtensions=_form.AllowedExtensionsText.Split(',',StringSplitOptions.RemoveEmptyEntries|StringSplitOptions.TrimEntries),
       scheduleTimes=_form.ScheduleTimesText.Split(',',StringSplitOptions.RemoveEmptyEntries|StringSplitOptions.TrimEntries).Select(x=>TimeOnly.Parse(x).ToString("HH:mm:ss")),
       days=_form.Days,timeZoneId=_form.TimeZoneId,gracePeriodMinutes=_form.GracePeriodMinutes,
       stabilityPeriodSeconds=_form.StabilityPeriodSeconds,isEnabled=true };
     var response=_editingId.HasValue
       ? await Api.PutAsJsonAsync($"api/monitoring-rules/{_editingId.Value}",payload)
       : await Api.PostAsJsonAsync("api/monitoring-rules",payload);
     if(!response.IsSuccessStatusCode){_error="L'enregistrement a échoué : "+await response.Content.ReadAsStringAsync();return;}
     _showForm=false;_message=_editingId.HasValue?"La règle a été mise à jour.":"La règle a été créée. Le moteur la prendra en compte au prochain cycle.";
     _editingId=null;await LoadAsync();
   } catch(Exception ex){_error="Vérifiez les noms de fichiers, les horaires et le fuseau horaire : "+ex.Message;}
   finally{_saving=false;}
 }
 private async Task ToggleAsync(RuleView rule)
 {
   var response=await Api.PatchAsJsonAsync($"api/monitoring-rules/{rule.Id}/enabled",new {isEnabled=!rule.IsEnabled});
   if(response.IsSuccessStatusCode){_message=$"Règle « {rule.Name} » mise à jour.";await LoadAsync();}else{_error="Impossible de modifier cette règle.";}
 }
 private void AskDelete(RuleView rule)=>_pendingDelete=rule;
 private void CancelDelete()=>_pendingDelete=null;
 private async Task ConfirmDeleteAsync()
 {
   if(_pendingDelete is null)return;
   var rule=_pendingDelete;
   var response=await Api.DeleteAsync($"api/monitoring-rules/{rule.Id}");
   _pendingDelete=null;
   if(response.IsSuccessStatusCode){_message=$"Règle « {rule.Name} » supprimée.";await LoadAsync();}else{_error="Impossible de supprimer cette règle.";}
 }
 private static string MatchingLabel(int mode)=>mode switch{0=>"Noms exacts",1=>"Modèle",2=>"Motif",3=>"Quantité",_=>"Inconnu"};
 private sealed class RuleForm { public string Name{get;set;}=""; public string FolderPath{get;set;}=""; public int MatchingMode{get;set;} public string ExpectedFileNamesText{get;set;}=""; public string FileNamePattern{get;set;}=""; public int ExpectedCount{get;set;}=1; public string AllowedExtensionsText{get;set;}="csv"; public string ScheduleTimesText{get;set;}="08:00, 12:00"; public DateTime ScheduleStartTime{get;set;}=DateTime.Today.AddHours(8); public DateTime ScheduleEndTime{get;set;}=DateTime.Today.AddHours(23); public int ScheduleIntervalMinutes{get;set;}=60; public int Days{get;set;}=31; public string TimeZoneId{get;set;}="Europe/Paris"; public int GracePeriodMinutes{get;set;}=15; public int StabilityPeriodSeconds{get;set;}=5; }
 private sealed class RuleView { public Guid Id{get;set;} public string Name{get;set;}=""; public string FolderPath{get;set;}=""; public int MatchingMode{get;set;} public int GracePeriodMinutes{get;set;} public int StabilityPeriodSeconds{get;set;} public int Days{get;set;} public int ExpectedCount{get;set;} public string? FileNamePattern{get;set;} public List<string> ExpectedFileNames{get;set;}=[]; public List<string> AllowedExtensions{get;set;}=[]; public string TimeZoneId{get;set;}=""; public bool IsEnabled{get;set;} public List<string> ScheduleTimes{get;set;}=[]; }
}
