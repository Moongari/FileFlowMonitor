@page "/operations"
@implements IAsyncDisposable
@inject IHttpClientFactory ClientFactory
@inject Microsoft.JSInterop.IJSRuntime JS
<PageTitle>Fichiers et incidents | FileFlow Monitor</PageTitle>
<div class="page-heading"><div><div class="eyebrow">ACTIVITÉ OPÉRATIONNELLE</div><h1>Fichiers & incidents</h1><p>Suivez les réceptions attendues, les fichiers détectés et les anomalies. Actualisation automatique toutes les 30 secondes.</p></div><div class="heading-actions"><button class="button-primary" disabled="@_reconciling" @onclick="ForceReconciliationAsync">@(_reconciling ? "Réconciliation…" : "⟳ Forcer la réconciliation")</button><button class="button-secondary" @onclick="LoadAsync">↻ Actualiser</button><button class="button-danger" disabled="@_resetting" @onclick="ResetDataAsync">@(_resetting ? "Réinitialisation…" : "🗑 Réinitialiser les données")</button></div></div>
<div class="tabs"><button class='@TabClass("expected")' @onclick='() => Select("expected")'>Fichiers attendus</button><button class='@TabClass("received")' @onclick='() => Select("received")'>Fichiers détectés</button><button class='@TabClass("incidents")' @onclick='() => Select("incidents")'>Incidents</button><button class='@TabClass("executions")' @onclick='() => Select("executions")'>Cycles moteur</button></div>
@if (!string.IsNullOrEmpty(_error)){<div class="alert alert-error">@_error</div>}
@if (!string.IsNullOrEmpty(_success)){<div class="alert alert-success">@_success</div>}
<section class="panel">
<div class="panel-heading"><div><h2>@TabTitle</h2><p>@TabDescription</p></div>
@if(_tab=="expected"){<input class="date-filter" type="date" @bind="_date" @bind:after="LoadAsync" />}
</div>
@if(_loading){<div class="loading-panel">Chargement des données…</div>}
else if(_rows.Count==0){<div class="empty-state"><div class="empty-icon">✓</div><h3>Aucune donnée à afficher</h3><p>Les éléments apparaîtront dès que le moteur aura effectué ses premières réconciliations.</p></div>}
else{
@if(_tab=="incidents" && _editingIncidentId.HasValue)
{
 <div class="incident-editor">
  <div class="panel-heading"><div><h3>Traitement de l'incident</h3><p>Mettre à jour le suivi et conserver une trace de chaque action.</p></div><button class="button-secondary" @onclick="CloseIncidentEditor">Fermer</button></div>
  <div class="incident-edit-grid">
   <label>Statut<select @bind="_incidentStatus"><option value="Open">Ouvert</option><option value="InProgress">En cours</option><option value="Resolved">Résolu</option><option value="Closed">Clos</option></select></label>
   <label>Priorité<select @bind="_incidentSeverity"><option value="Low">Basse</option><option value="Medium">Normale</option><option value="High">Haute</option><option value="Critical">Critique</option></select></label>
   <label>Assigné à<input @bind="_incidentAssignee" maxlength="150" placeholder="Nom ou équipe" /></label>
   <label class="incident-comment">Commentaire de résolution<textarea @bind="_incidentComment" maxlength="2000" rows="2" placeholder="Diagnostic, action réalisée, vérification…"></textarea></label>
  </div>
  <div class="heading-actions"><button class="button-primary" disabled="@_savingIncident" @onclick="SaveIncidentWorkflowAsync">@(_savingIncident?"Enregistrement…":"Enregistrer le suivi")</button><button class="button-secondary" @onclick="LoadIncidentHistoryAsync">Actualiser l'historique</button></div>
  @if(_incidentHistory.Count>0)
  {
   <div class="incident-history"><h4>Historique</h4>@foreach(var item in _incidentHistory){<div class="incident-history-item"><strong>@item.GetProperty("action").GetString()</strong><span>@item.GetProperty("occurredAtUtc").GetDateTimeOffset().ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</span><p>@(item.TryGetProperty("details",out var details)?details.GetString():"")</p></div>}</div>
  }
 </div>
}
<div class="table-wrap"><table><thead><tr>@foreach(var col in _columns){<th>@col</th>} @if(_tab=="incidents"){<th>Actions</th>}</tr></thead><tbody>
@foreach(var row in _rows){<tr>@foreach(var col in _keys){<td>@Cell(row,col)</td>} @if(_tab=="incidents"){<td><button class="button-secondary button-small" @onclick="() => EditIncidentAsync(row)">Gérer</button></td>}</tr>}
</tbody></table></div>}
</section>
@code{
 private bool _resetting; private bool _savingIncident; private Guid? _editingIncidentId; private string _incidentStatus="Open"; private string _incidentSeverity="Medium"; private string _incidentAssignee=""; private string _incidentComment=""; private List<JsonElement> _incidentHistory=[]; private string _tab="expected"; private DateTime _date=DateTime.Today; private bool _loading=true; private bool _reconciling; private string? _error; private string? _success; private List<JsonElement> _rows=[]; private string[] _columns=[]; private string[] _keys=[];
 private string TabTitle=>_tab switch{"expected"=>"Fichiers attendus","received"=>"Fichiers détectés","incidents"=>"Incidents de surveillance",_=>"Historique des cycles"};
 private string TabDescription=>_tab switch{"expected"=>"Échéances calculées à partir des règles et de leurs horaires.","received"=>"Fichiers observés dans les dossiers surveillés, après détection.","incidents"=>"Incidents ouverts et résolus : dossier inaccessible, erreur de traitement, etc.",_=>"Exécutions périodiques du moteur de réconciliation."};
 private readonly CancellationTokenSource _refreshCancellation = new();
 private Task _refreshLoop = Task.CompletedTask;
 protected override async Task OnInitializedAsync(){await LoadAsync();_refreshLoop=RefreshLoopAsync(_refreshCancellation.Token);}
 private async Task RefreshLoopAsync(CancellationToken cancellationToken){
  try{using var timer=new PeriodicTimer(TimeSpan.FromSeconds(30));while(await timer.WaitForNextTickAsync(cancellationToken))await InvokeAsync(LoadAsync);}
  catch(OperationCanceledException) when(cancellationToken.IsCancellationRequested){}
 }
 public async ValueTask DisposeAsync(){_refreshCancellation.Cancel();await _refreshLoop;_refreshCancellation.Dispose();}
 private async Task EditIncidentAsync(JsonElement row){
  _editingIncidentId=row.GetProperty("id").GetGuid();
  _incidentStatus=row.TryGetProperty("status",out var status)?status.GetString()??"Open":"Open";
  _incidentSeverity=row.TryGetProperty("severity",out var severity)?severity.GetString()??"Medium":"Medium";
  _incidentAssignee=row.TryGetProperty("assignedTo",out var assignee)&&assignee.ValueKind==JsonValueKind.String?assignee.GetString()??"": "";
  _incidentComment=row.TryGetProperty("resolutionComment",out var comment)&&comment.ValueKind==JsonValueKind.String?comment.GetString()??"": "";
  _incidentHistory=[];await LoadIncidentHistoryAsync();
 }
 private void CloseIncidentEditor(){_editingIncidentId=null;_incidentHistory=[];}
 private async Task SaveIncidentWorkflowAsync(){
  if(!_editingIncidentId.HasValue||_savingIncident)return;
  _savingIncident=true;_error=null;_success=null;
  try{
   var api=ClientFactory.CreateClient("FileFlowApi");
   var payload=new { status=_incidentStatus,severity=_incidentSeverity,assignedTo=_incidentAssignee,resolutionComment=_incidentComment };
   using var response=await api.PatchAsJsonAsync($"api/monitoring/incidents/{_editingIncidentId}/workflow",payload);
   var body=await response.Content.ReadAsStringAsync();
   if(!response.IsSuccessStatusCode)throw new InvalidOperationException($"API {(int)response.StatusCode}: {body}");
   _success="Suivi de l'incident enregistré.";
   await LoadAsync();await LoadIncidentHistoryAsync();
  }catch(Exception ex){_error="Impossible d'enregistrer l'incident : "+ex.Message;}
  finally{_savingIncident=false;}
 }
 private async Task LoadIncidentHistoryAsync(){
  if(!_editingIncidentId.HasValue)return;
  try{
   var api=ClientFactory.CreateClient("FileFlowApi");
   var items=await api.GetFromJsonAsync<List<JsonElement>>($"api/monitoring/incidents/{_editingIncidentId}/history");
   _incidentHistory=items??[];
  }catch(Exception ex){_error="Impossible de charger l'historique : "+ex.Message;}
 }
 private string TabClass(string t)=>_tab==t?"tab active":"tab";
 private async Task Select(string t){_tab=t;_rows=[];await LoadAsync();}
 private async Task ForceReconciliationAsync(){
  if(_reconciling)return;
  _reconciling=true;_error=null;_success=null;
  try{
   var api=ClientFactory.CreateClient("FileFlowApi");
   using var response=await api.PostAsync("api/monitoring/reconcile",null);
   var body=await response.Content.ReadAsStringAsync();
   if(!response.IsSuccessStatusCode)throw new InvalidOperationException($"API {(int)response.StatusCode}: {body}");
   using var doc=JsonDocument.Parse(body);
   var root=doc.RootElement;
   var completed=root.TryGetProperty("completedRules",out var count)?count.GetInt32():0;
   var failed=root.TryGetProperty("failedRules",out var errors)?errors.GetInt32():0;
   var detected=root.TryGetProperty("filesDetected",out var detectedValue)?detectedValue.GetInt32():0;
   var expected=root.TryGetProperty("expectedOccurrences",out var expectedValue)?expectedValue.GetInt32():0;
   var matched=root.TryGetProperty("matchedOccurrences",out var matchedValue)?matchedValue.GetInt32():0;
   var missing=root.TryGetProperty("missingOccurrences",out var missingValue)?missingValue.GetInt32():0;
   _success=$"Réconciliation terminée : {completed} règle(s), {detected} fichier(s) détecté(s), {matched}/{expected} occurrence(s) rapprochée(s), {missing} manquante(s), {failed} erreur(s).";
   await LoadAsync();
  }catch(Exception ex){_error="Échec de la réconciliation forcée : "+ex.Message;}
  finally{_reconciling=false;}
 }
 private async Task ResetDataAsync(){
  if(_resetting)return;
  var confirmed=await JS.InvokeAsync<bool>("confirm", new object?[] { "ATTENTION : cette action va supprimer toutes les règles, horaires, fichiers détectés, occurrences attendues, incidents et historiques. La structure de la base sera conservée. Voulez-vous continuer ?" });
  if(!confirmed)return;
  _resetting=true;_error=null;_success=null;
  try{
   var api=ClientFactory.CreateClient("FileFlowApi");
   using var response=await api.PostAsync("api/monitoring/reset",null);
   var body=await response.Content.ReadAsStringAsync();
   if(!response.IsSuccessStatusCode)throw new InvalidOperationException($"API {(int)response.StatusCode}: {body}");
   _success="Réinitialisation terminée : toutes les données de monitoring ont été supprimées.";
   await LoadAsync();
  }catch(Exception ex){_error="Échec de la réinitialisation : "+ex.Message;}
  finally{_resetting=false;}
 }
 private async Task LoadAsync(){
  _loading=_rows.Count==0;_error=null;
  try{
   var api=ClientFactory.CreateClient("FileFlowApi");
   var url=_tab switch{"expected"=>$"api/monitoring/expected-files?date={_date:yyyy-MM-dd}","received"=>"api/monitoring/received-files?limit=200","incidents"=>"api/monitoring/incidents?limit=200","executions"=>"api/monitoring/executions?limit=200",_=>""};
   using var doc=await api.GetFromJsonAsync<JsonDocument>(url);_rows=doc?.RootElement.EnumerateArray().Select(x=>x.Clone()).ToList()??[];
   (_keys,_columns)=_tab switch{
    "expected"=>(new[] {"ruleName","expectedFileName","expectedAtLocal","deadlineAtLocal","receivedAtLocal","status"},new[] {"Flux","Fichier attendu","Heure prévue","Échéance","Réception","Statut"}),
    "received"=>(new[] {"fileName","fullPath","sizeBytes","detectedAtUtc","stableAtUtc"},new[] {"Fichier","Chemin complet","Taille (octets)","Détecté le","Stable depuis"}),
    "incidents"=>(new[] {"code","message","occurredAtUtc","status","severity","assignedTo","isResolved","resolvedAtUtc"},new[] {"Code","Description","Détecté le","Statut","Priorité","Assigné à","Résolu","Résolu le"}),
    _=>(new[] {"startedAtUtc","completedAtUtc","filesDiscovered","error"},new[] {"Démarré le","Terminé le","Fichiers détectés","Erreur"})};
  }catch(Exception ex){_error="Impossible de récupérer les données : "+ex.Message;_rows=[];}
  finally{_loading=false;}
 }
 private string Cell(JsonElement row,string key){
  if(!row.TryGetProperty(key,out var v)||v.ValueKind==JsonValueKind.Null)return "—";
  if(key.EndsWith("AtUtc")&&v.ValueKind==JsonValueKind.String&&v.TryGetDateTimeOffset(out var dt))return dt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss");
  if((key is "expectedAtLocal" or "deadlineAtLocal" or "receivedAtLocal")&&v.ValueKind==JsonValueKind.String&&DateTime.TryParse(v.GetString(),out var local))return local.ToString("dd/MM/yyyy HH:mm:ss");
  if(key=="sizeBytes"&&v.TryGetInt64(out var bytes))return bytes.ToString("N0");
  if(key=="isResolved")return v.GetBoolean()?"Oui":"Non";
  if(key=="status"&&v.ValueKind==JsonValueKind.String)return v.GetString() switch{"Open"=>"Ouvert","InProgress"=>"En cours","Resolved"=>"Résolu","Closed"=>"Clos","Received"=>"Reçu","Late"=>"En retard","Missing"=>"Manquant","Waiting"=>"En attente","Scheduled"=>"Planifié","Invalid"=>"Invalide","Duplicate"=>"Doublon","Cancelled"=>"Annulé",_=>v.GetString()??"—"};
  if(key=="severity"&&v.ValueKind==JsonValueKind.String)return v.GetString() switch{"Low"=>"Basse","Medium"=>"Normale","High"=>"Haute","Critical"=>"Critique",_=>v.GetString()??"—"};
  return v.ToString();
 }
}
