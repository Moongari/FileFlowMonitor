<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- Emit XML comments so Swagger can show endpoint and contract documentation. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../FileFlowMonitor.Application/FileFlowMonitor.Application.csproj" />
    <ProjectReference Include="../FileFlowMonitor.Infrastructure/FileFlowMonitor.Infrastructure.csproj" />
  </ItemGroup>

  <!--
    Keep OpenAPI.NET aligned with Swashbuckle's API surface.
    Swashbuckle 6.x (ASP.NET Core 8) uses OpenAPI.NET 1.x; that line is
    not affected by GHSA-v5pm-xwqc-g5wc.
    Swashbuckle 10.x uses OpenAPI.NET 2.x, so pin its patched release.
  -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <PackageReference Include="Microsoft.OpenApi" Version="1.6.26" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
  </ItemGroup>
</Project>
